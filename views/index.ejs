<input class="hidden" name="newSession" id="newSession" value="<%= newSession %>"/>
<input class="hidden" name="loggedIn" id="loggedIn" value="<%= loggedIn %>"/>
<div id="main" class="mx-auto w-full flex flex-col flex-1 min-h-fit gap-2.5 place-content-evenly transition-blur duration-400 ease-in-out items-center">
    <div class="mx-auto w-4/5 text-gray-300 text-shadow-lg text-shadow-orange-600 text-4xl md:text-6xl rounded-xl shadow-lg shadow-sky-700 hover:shadow-orange-700 transition-color duration-200 ease-in-out">
        <h1 class="mx-auto -mb-3 text-xs lg:text-lg text-shadow-lg text-shadow-blue-600">BANK-</h1>
        <h1 class="mx-auto">BREAKERS</h1>
    </div>
    <form action="/questions/byCategory" method="POST"
    class="w-95/100 xl:w-2/3 h-fit min-h-2/3 py-3 flex flex-col place-content-evenly mx-auto border-2 border-gray-400 bg-neutral-800 rounded-2xl">
        <div
        class="mx-auto w-full max-w-9/10 mt-5 mb-3">
            <ul
            class="m-auto flex p-4 place-content-evenly gap-3 md:gap-0 text-center w-full text-white">
                <li
                class="text-xs md:text-md lg:text-2xl w-1/2 md:w-4/10 h-12 md:h-15 relative" >
                    <label for="matchAll"
                        class="flex items-center h-full w-full place-content-center text-xs md:text-xl lg:text-2xl text-gray-300 gap-3 hover:cursor-pointer border-1 border-sky-400 bg-gray-800 hover:bg-sky-900 active:bg-green-800 rounded-2xl" >
                        <input type="radio" id="matchAll" name="matchAll" value="1"
                        class="w-4 h-4 accent-green-500 rounded-sm">
                        Match All
                    </label>
                    <p id="match-all-popover" class="absolute hidden opacity-0 transition-opacity duration-200 ease-in-out mx-auto -top-12 md:-top-5 w-fit py-0.5 px-1.5 text-xs text-slate-950 border-1 border-blue-800 bg-yellow-300 rounded-lg">Question(s) will have <em>each</em> category selected.</p>
                </li>
                <li
                class="text-xs md:text-md lg:text-2xl w-1/2 md:w-4/10 h-12 md:h-15 relative">
                    <label for="matchAny"
                        class="flex items-center h-full w-full place-content-center text-xs md:text-xl lg:text-2xl text-gray-300 gap-3 hover:cursor-pointer border-1 border-sky-400 bg-gray-800 hover:bg-sky-900 active:bg-green-800 rounded-2xl">
                        <input type="radio" id="matchAny" name="matchAll" value="0"
                        class="w-4 h-4 accent-green-500 rounded-sm" >
                        Match Any
                    </label>
                    <p id="match-any-popover" class="absolute hidden opacity-0 transition-opacity duration-200 ease-in-out mx-auto -top-12 md:-top-5 w-fit py-0.5 px-1.5 text-xs text-slate-950 border-1 border-blue-800 bg-yellow-300 rounded-lg">Question(s) will have <em>at least one</em> selected category.</p>
                </li>
            </ul>
        </div>
        <div class="m-auto flex place-content-center gap-5 w-full h-12 md:h-20 text-white py-2 px-5 rounded-full mt-2 md:mt-5 mb-0">
            <input type="text" name="search" id="search-bar" placeholder="Search Specific Content"
            class="px-2 h-full text-center w-7/10 text-xs md:text-lg lg:text-lg border-1 border-gray-300 bg-zinc-900 focus:outline-2 focus:outline-green-400 rounded-lg">
        </div>
        <div class="flex items-center place-content-evenly my-2">
            <button type="button" id="select-all" class="block w-1/3 m-auto items-center px-3 py-2.5 text-xs md:text-base font-medium text-center text-white bg-lime-800 rounded-lg hover:bg-lime-950 active:bg-lime-600 hover:cursor-pointer border-1 border-yellow-400">
               Select All
               </button>
            <button type="reset" id="reset" class="block w-1/3 m-auto items-center px-2 md:px-3 py-2.5 text-xs md:text-base text-center text-white bg-rose-800 rounded-lg hover:bg-rose-950 active:bg-rose-600 hover:cursor-pointer border-1 border-yellow-400">
               Un-Select All
               </button>
        </div>
        <div
        class="mx-auto w-9/10 flex place-content-evenly my-2 text-center">
            <div class="w-1/3">
                <input type="submit" value="Get Questions"
                class="text-center h-full w-full text-xs md:text-lg block bg-indigo-800 active:bg-indigo-950 hover:bg-indigo-600 text-white py-2.5 px-2 rounded-full border-1 border-white hover:cursor-pointer hover:font-bold text-shadow-sky-400 hover:text-shadow-sm">
            </div>
            <div class="w-1/3">
                <input type="submit" formaction="/questions/getSingleRandom" value="Get Random"
                class="text-center h-full w-full text-xs md:text-lg block bg-indigo-800 active:bg-indigo-950 hover:bg-indigo-600 text-white py-2.5 px-2 rounded-full border-1 border-white hover:cursor-pointer hover:font-bold text-shadow-sky-400 hover:text-shadow-sm">
            </div>
        </div>
        <div
        class="mx-auto w-95/100 h-fit p-3 bg-zinc-900 border-2 border-stone-400 text-white rounded-3xl">
            <ul
            class="m-auto flex flex-wrap gap-2 place-content-evenly items-stretch text-center h-fit w-full">
            <% allCats.forEach(cat =>{ %>
                <li
                class="m-auto my-1 md:my-2 w-3/10 flex flex-col place-content-center items-center">
                <label for="<%= cat %>"
                class="py-2 px-3 flex flex-col items-center place-content-evenly text-xs md:text-lg lg:text-2xl h-full w-full text-white hover:bg-cyan-950 active:bg-yellow-600 transition-color duration-120 ease-in-out hover:cursor-pointer bg-emerald-600 border-2 border-cyan-400 rounded-2xl">
                    <input type="checkbox" id="<%= cat %>" name="categori" value="<%= cat %>"
                    class="h-3 w-3 md:h-5 md:w-5 checkbox accent-indigo-800 break-normal">
                    <%= cat %>
                </label>
                </li>
            <% }) %>
            </ul>
        </div>
    
    </form>
</div>

<div id="log-in" class="hidden fixed z-1 top-0 left-0 w-full h-svh flex flex-col place-content-center opacity-0 transition-opacity duration-300 ease-in-out">
    <div id="warning" class="m-auto py-6 px-3 h-1/2 w-4/5 md:w-2/3 lg:w-1/3 flex-col gap-2 bg-gray-700 border-1 border-yellow-600 bg-yellow-900 rounded-xl justify-content-center items-center">
        <div class="m-auto h-full flex flex-col gap-3 place-content-between p-4 min-w-8/10 w-9/10 min-h-4/10 text-emerald-600 border border-white rounded-lg bg-gray-800" role="alert">
            <div class="flex flex-1 items-center">
                <svg class="shrink-0 w-6 h-6 me-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="yellow" viewBox="0 0 20 20">
                <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
                </svg>
                <span class="sr-only">Info</span>
                <h3 class="text-base md:text-lg text-yellow-800 font-semibold border-b-2 border-b-yellow-700">Your are not logged in!</h3>
            </div>
            <div class="message text-base md:text-lg text-wrap text-yellow-800 flex flex-col flex-3 min-w-9/10 text-center place-content-evenly items-center px-3 pt-2 pb-10 m-auto border-1 border-yellow-800 bg-slate-900 rounded-2xl">
                <p>To unlock features like <span class="text-indigo-500 font-extrabold">AI Assistance</span> and more:</p>
                <p class="text-sky-600 font-semibold"><a href="/auth">Log In</a></p>
                <p>OR</p>
                <p class="text-sky-600 font-semibold"><a href="/auth/signup">Sign Up</a></p>
            </div>
            <div class="flex">
                <button id="dismiss" type="button" class="dismiss text-yellow-800 bg-transparent border-1 border-yellow-800 hover:bg-yellow-900 hover:text-white hover:cursor-pointer focus:ring-4 focus:ring-white rounded-lg text-xs px-3 py-1.5 text-center hover:bg-yellow-600 border-yellow-600 text-yellow-500" data-dismiss-target="#alert-additional-content-2" aria-label="Close">
                Dismiss
                </button>
            </div>
        </div>
    </div>
</div>

<script src="../index.js"></script>